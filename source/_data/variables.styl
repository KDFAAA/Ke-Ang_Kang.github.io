// ==================================================
// NexT Theme - Color Scheme Override
// Black-Gray + Deep Blue Theme
// ==================================================

// ---------- Light Mode Colors ----------
// Primary palette
$theme-color           = #1a56db;

// Scaffolding colors
$body-bg-color         = #eef1f5;
$content-bg-color      = #ffffff;
$card-bg-color         = #f8f9fb;

// Text colors
$text-color            = #2c3e50;
$text-color-dark       = #c9d1d9;

// Link colors
$link-color            = #1a56db;
$link-color-dark       = #58a6ff;
$link-hover-color      = #1040b0;
$link-hover-color-dark = #79c0ff;
$link-decoration-color = #8b9dc3;

// Blockquote
$blockquote-color      = #5a6c7d;
$blockquote-color-dark = #8b949e;

// Border
$border-color          = #d1d9e6;

// Selection
$selection-bg          = #1a56db;
$selection-color       = #ffffff;

// Table
$table-row-odd-bg-color       = #f0f4f8;
$table-row-odd-bg-color-dark  = #1c2128;
$table-row-hover-bg-color     = #e8edf3;
$table-row-hover-bg-color-dark = #252c36;

// Button
$btn-default-bg                   = #ffffff;
$btn-default-bg-dark              = #21262d;
$btn-default-color                = #2c3e50;
$btn-default-color-dark           = #c9d1d9;
$btn-default-border-color         = #1a56db;
$btn-default-border-color-dark    = #30363d;
$btn-default-hover-bg             = #1a56db;
$btn-default-hover-bg-dark        = #1f2a48;
$btn-default-hover-color          = #ffffff;
$btn-default-hover-color-dark     = #58a6ff;
$btn-default-hover-border-color   = #1040b0;
$btn-default-hover-border-color-dark = #1a56db;
$btn-default-radius               = 6px;

// Menu item bg
$menu-item-bg-color        = #f0f4f8;
$menu-item-bg-color-dark   = #1c2128;

// ---------- Dark Mode Colors ----------
$body-bg-color-dark        = #0d1117;
$content-bg-color-dark     = #161b22;
$card-bg-color-dark        = #21262d;

// ---------- Headband (top accent line) ----------
$headband-bg               = #1a56db;
$headband-height           = 3px;

// ---------- Header ----------
$head-bg                   = transparent;
$brand-color               = #ffffff;
$brand-hover-color         = #ffffff;
$brand-color-dark          = #e6edf3;
$brand-hover-color-dark    = #e6edf3;
$subtitle-color            = #c9d1d9;
$site-subtitle-color       = #8b949e;

// ---------- Sidebar ----------
$sidebar-nav-color         = var(--text-color);
$sidebar-nav-hover-color   = #1a56db;
$sidebar-highlight         = #1a56db;

$site-author-image-width          = 120px;
$site-author-image-border-width   = 1px;
$site-author-image-border-color   = #d1d9e6;

$site-author-name-color           = var(--text-color);
$site-author-name-weight          = 600;
$site-author-name-margin          = 8px 0 0;

$site-description-font-size       = .875em;
$site-description-color           = #5a6c7d;
$site-description-margin-top      = 5px;

$site-state-item-count-font-size  = 1em;
$site-state-item-name-font-size   = .8125em;
$site-state-item-name-color       = #5a6c7d;
$site-state-item-border-color     = #d1d9e6;

// ---------- Pagination ----------
$pagination-active-bg             = #1a56db;
$pagination-active-color          = #ffffff;
$pagination-active-border         = #1a56db;

// ---------- Back to Top ----------
$b2t-opacity               = 0.6;
$b2t-opacity-hover         = 0.9;
$b2t-bg-color              = #1a56db;
$b2t-color                 = #ffffff;

// ---------- Note colors ----------
$note-border-radius        = 6px;
$note-modern-default-bar-bg  = #1a56db;
$note-modern-primary-bar-bg  = #1a56db;

// ---------- Reading progress bar ----------
// Color is set via _config.yml reading_progress.color
